import Mathlib

namespace Lemmata.IsotypicGeneration

variable {R M N : Type*} [Ring R] [AddCommGroup M] [Module R M]
    [AddCommGroup N] [Module R N] [IsSimpleModule R M]

/-- A module generated by copies of one simple module is semisimple of that type. -/
theorem properties (hsup : ⨆ f : M →ₗ[R] N, LinearMap.range f = ⊤) :
    IsIsotypicOfType R N M ∧ IsSemisimpleModule R N := by
  have ht : isotypicComponent R N M = ⊤ := by
    rw [eq_top_iff, ← hsup]
    refine iSup_le fun f => ?_
    by_cases hf : f = 0
    · simp [hf]
    · exact le_sSup ⟨(LinearEquiv.ofInjective f
        ((LinearMap.injective_or_eq_zero f).resolve_right hf)).symm⟩
  exact ⟨IsIsotypicOfType.of_isotypicComponent_eq_top ht,
    isSemisimpleModule_of_isSemisimpleModule_submodule'
      (p := fun f : M →ₗ[R] N => LinearMap.range f)
      (fun f => IsSemisimpleModule.range f) hsup⟩

/-- Copies of one simple module form a cogenerating family as well as a generating one. -/
theorem separates (hsup : ⨆ f : M →ₗ[R] N, LinearMap.range f = ⊤)
    {v : N} (hv : v ≠ 0) : ∃ f : N →ₗ[R] M, f v ≠ 0 := by
  obtain ⟨hiso, hss⟩ := properties hsup
  let := hss
  obtain ⟨ι, ⟨e⟩⟩ := hiso.linearEquiv_finsupp
  by_contra hno
  push Not at hno
  apply hv
  apply e.injective
  ext i
  simpa using hno (Finsupp.lapply i ∘ₗ e.toLinearMap)

/-- In an isotypic representation, intertwining maps to its irreducible type separate vectors. -/
theorem intertwiner {k G W V : Type*} [Field k] [Monoid G]
    [AddCommGroup W] [Module k W] [AddCommGroup V] [Module k V]
    (σ : Representation k G W) (τ : Representation k G V) (hirr : σ.IsIrreducible)
    (hsup : ⨆ f : {f : W →ₗ[k] V // ∀ (g : G) (x : W), f (σ g x) = τ g (f x)},
      LinearMap.range (f : W →ₗ[k] V) = ⊤) {v : V} (hv : v ≠ 0) :
    ∃ f : Representation.IntertwiningMap τ σ, f v ≠ 0 := by
  have : IsSimpleModule (MonoidAlgebra k G) σ.asModule :=
    (Representation.irreducible_iff_isSimpleModule_asModule σ).mp hirr
  have hs : ⨆ f : σ.asModule →ₗ[MonoidAlgebra k G] τ.asModule, LinearMap.range f = ⊤ := by
    rw [← Submodule.restrictScalars_eq_top_iff k, Submodule.restrictScalars_iSup]
    apply top_unique
    change (⊤ : Submodule k V) ≤ _
    rw [← hsup]
    refine iSup_le fun f => ?_
    let F := f.1.intertwiningMap_of_isIntertwiningMap σ τ f.2
    refine le_iSup_of_le (Representation.IntertwiningMap.equivLinearMapAsModule σ τ F) ?_
    rintro _ ⟨x, rfl⟩
    exact ⟨σ.asModuleEquiv.symm x, rfl⟩
  obtain ⟨g, hg⟩ := separates hs (v := τ.asModuleEquiv.symm v) (by simpa using hv)
  exact ⟨(Representation.IntertwiningMap.equivLinearMapAsModule τ σ).symm g, hg⟩

/-- Every nonzero submodule of an isotypic semisimple module contains a copy of its type. -/
theorem embeds (hsup : ⨆ f : M →ₗ[R] N, LinearMap.range f = ⊤)
    (W : Submodule R N) (hW : W ≠ ⊥) :
    ∃ g : M →ₗ[R] N, Function.Injective g ∧ LinearMap.range g ≤ W := by
  obtain ⟨hiso, hss⟩ := properties hsup
  let := hss
  obtain ⟨S, hSW, hS⟩ := (IsSemisimpleModule.eq_bot_or_exists_simple_le W).resolve_left hW
  let := hS
  obtain ⟨e⟩ := hiso S
  exact ⟨S.subtype ∘ₗ e.symm, S.injective_subtype.comp e.symm.injective,
    fun _ ⟨x, hx⟩ => hx ▸ hSW (e.symm x).2⟩

end Lemmata.IsotypicGeneration
